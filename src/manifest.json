{
  "manifest_version": 3,
  "name": "German Highlight Translator",
  "version": "1.0.0",
  "description": "Instantly translate highlighted German text into English.",
  "minimum_chrome_version": "138",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}